@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-user-doctor text-primary me-2"></i>
            Welcome, Dr. @ViewBag.DoctorName @ViewBag.DoctorLastName
        </h2>
        <p class="text-muted mb-0">
            <i class="fa-solid fa-stethoscope me-1"></i>
            @(string.IsNullOrEmpty(ViewBag.DoctorSpecialty as string) ? "General Practice" : ViewBag.DoctorSpecialty)
            &mdash; @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </p>
    </div>
    <span class="badge bg-primary px-3 py-2">
        <i class="fa-solid fa-circle-dot me-1"></i>On Duty
    </span>
</div>

<!-- Stat Cards Row -->
<div class="row g-4 mb-4">
    <div class="col-sm-4 animate-in animate-delay-1">
        <div class="card stat-card text-white shadow" style="background: linear-gradient(135deg,#0d6efd,#0a58ca);">
            <div class="card-body position-relative">
                <i class="fa-solid fa-calendar-xmark stat-icon"></i>
                <p class="stat-label mb-1">Upcoming</p>
                <p class="stat-number mb-2">@ViewBag.UpcomingAppointments</p>
                <span class="stat-link">Scheduled appointments</span>
            </div>
        </div>
    </div>

    <div class="col-sm-4 animate-in animate-delay-2">
        <div class="card stat-card text-white shadow" style="background: linear-gradient(135deg,#198754,#157347);">
            <div class="card-body position-relative">
                <i class="fa-solid fa-circle-check stat-icon"></i>
                <p class="stat-label mb-1">Completed</p>
                <p class="stat-number mb-2">@ViewBag.CompletedAppointments</p>
                <span class="stat-link">Consultations done</span>
            </div>
        </div>
    </div>

    <div class="col-sm-4 animate-in animate-delay-3">
        <div class="card stat-card text-white shadow" style="background: linear-gradient(135deg,#fd7e14,#e06b0a);">
            <div class="card-body position-relative">
                <i class="fa-solid fa-calendar-day stat-icon"></i>
                <p class="stat-label mb-1">Today</p>
                <p class="stat-number mb-2">@ViewBag.TodayAppointments</p>
                <span class="stat-link">Today's schedule</span>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <h5 class="fw-semibold text-muted mb-3">
            <i class="fa-solid fa-bolt me-2"></i>Quick Actions
        </h5>
    </div>
    <div class="col-6 col-md-4">
        <a href="/Appointment/Index" class="quick-action-card">
            <div class="quick-action-icon text-primary">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="fw-semibold">My Schedule</div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/Patient/Index" class="quick-action-card">
            <div class="quick-action-icon text-success">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="fw-semibold">Patient Directory</div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/Doctor/Index" class="quick-action-card">
            <div class="quick-action-icon text-info">
                <i class="fa-solid fa-user-doctor"></i>
            </div>
            <div class="fw-semibold">Doctor Directory</div>
        </a>
    </div>
</div>

@if (ViewBag.TodayAppointments != null && (int)ViewBag.TodayAppointments > 0)
{
    <div class="alert alert-primary alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fa-solid fa-bell me-2"></i>
        You have <strong>@ViewBag.TodayAppointments</strong> patient(s) scheduled for today.
        <a href="/Appointment/Index" class="alert-link ms-1">View your schedule →</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}