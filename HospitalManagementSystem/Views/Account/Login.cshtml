@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-md-10">
                <div class="card auth-card shadow-lg">
                    <div class="row g-0">

                        <!-- Brand Panel (Left) -->
                        <div class="col-md-5 auth-brand-panel d-none d-md-flex">
                            <div>
                                <div class="auth-brand-icon">
                                    <i class="fa-solid fa-hospital-user"></i>
                                </div>
                                <h2 class="fw-bold mb-3">Hospital Care</h2>
                                <p class="opacity-75 mb-4">Your trusted partner in healthcare management. Streamlined, secure, and efficient.</p>
                                <div class="d-flex flex-column gap-3 text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-shield-halved fa-lg"></i>
                                        <span>Bank-grade security</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-calendar-check fa-lg"></i>
                                        <span>Easy appointment booking</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-file-invoice-dollar fa-lg"></i>
                                        <span>Transparent billing</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Panel (Right) -->
                        <div class="col-md-7 auth-form-panel">
                            <div class="mb-4 text-center">
                                <i class="fa-solid fa-right-to-bracket fa-2x text-primary mb-2"></i>
                                <h3 class="fw-bold text-dark">Welcome Back!</h3>
                                <p class="text-muted">Sign in to your account to continue.</p>
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <!-- Server error — also show via SweetAlert in script below -->
                                <div id="server-login-error" data-message="@ViewBag.Error" style="display:none;"></div>
                            }

                            <form asp-action="Login" method="post" id="loginForm">
                                <div class="mb-3">
                                    <label for="username" class="form-label">
                                        <i class="fa-solid fa-user me-1 text-primary"></i>Username
                                    </label>
                                    <input type="text" class="form-control" id="username" name="username"
                                           required placeholder="Enter your username" autocomplete="username" />
                                </div>

                                <div class="mb-4">
                                    <label for="password" class="form-label">
                                        <i class="fa-solid fa-lock me-1 text-primary"></i>Password
                                    </label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="password" name="password"
                                               required placeholder="Enter your password" autocomplete="current-password" />
                                        <button type="button" class="toggle-password" id="togglePassword"
                                                title="Show/Hide password">
                                            <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-primary btn-lg" id="loginBtn">
                                        <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                                    </button>
                                </div>
                            </form>

                            <hr class="my-3" />

                            <div class="text-center">
                                <p class="text-muted mb-0">
                                    Don't have an account?
                                    <a href="/Account/Register" class="text-primary fw-semibold text-decoration-none">Create Account</a>
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Show server-side login error via SweetAlert2
        const errEl = document.getElementById('server-login-error');
        if (errEl) {
            Swal.fire({
                icon: 'error',
                title: 'Login Failed',
                text: errEl.getAttribute('data-message'),
                confirmButtonColor: '#0d6efd',
                confirmButtonText: 'Try Again'
            });
        }

        // Show/Hide Password Toggle
        const toggleBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('togglePasswordIcon');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                toggleIcon.className = isPassword ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
            });
        }

        // Submit button loading state
        const loginForm = document.getElementById('loginForm');
        const loginBtn = document.getElementById('loginBtn');
        if (loginForm && loginBtn) {
            loginForm.addEventListener('submit', function () {
                loginBtn.disabled = true;
                loginBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Signing In...';
            });
        }
    });
</script>
}