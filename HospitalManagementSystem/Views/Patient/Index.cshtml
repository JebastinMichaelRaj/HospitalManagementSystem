@model IEnumerable<HospitalManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patient Directory";
    var modelList = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-users text-primary me-2"></i>Patient Directory
        </h2>
        <p class="text-muted mb-0">@modelList.Count registered patient(s)</p>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa-solid fa-search text-muted"></i>
                    </span>
                    <input type="text" id="patientSearch" class="form-control border-start-0"
                           placeholder="Search by name or contact number..." />
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary" id="clearSearch">
                    <i class="fa-solid fa-rotate-left me-1"></i>Clear
                </button>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-primary px-3 py-2" id="patientCount">@modelList.Count patients</span>
            </div>
        </div>
    </div>
</div>

<!-- Patient Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!modelList.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-user-slash"></i>
                </div>
                <h5 class="fw-semibold">No Patients Found</h5>
                <p class="text-muted">No patients have registered in the system yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="patientsTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4"><i class="fa-solid fa-user me-2"></i>Name</th>
                            <th><i class="fa-regular fa-calendar me-2"></i>Date of Birth</th>
                            <th><i class="fa-solid fa-phone me-2"></i>Contact</th>
                            <th><i class="fa-solid fa-calendar-plus me-2"></i>Registered</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in modelList)
                        {
                            var initials = "";
                            if (!string.IsNullOrEmpty(patient.FirstName)) initials += patient.FirstName[0].ToString().ToUpper();
                            if (!string.IsNullOrEmpty(patient.LastName)) initials += patient.LastName[0].ToString().ToUpper();
                            if (string.IsNullOrEmpty(initials)) initials = "P";

                            <tr class="patient-row"
                                data-name="@patient.FirstName @patient.LastName"
                                data-contact="@patient.ContactNumber">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                             style="width:40px;height:40px;font-size:0.85rem;flex-shrink:0;">
                                            @initials
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@patient.FirstName @patient.LastName</div>
                                            @if (patient.FirstName == "Pending")
                                            {
                                                <small class="badge bg-warning text-dark">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Profile Incomplete
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (patient.DateOfBirth.HasValue)
                                    {
                                        <span>@patient.DateOfBirth.Value.ToString("MMM dd, yyyy")</span>
                                        <br />
                                        <small class="text-muted">
                                            Age: @(DateTime.Today.Year - patient.DateOfBirth.Value.Year)
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.ContactNumber))
                                    {
                                        <span><i class="fa-solid fa-phone me-1 text-muted"></i>@patient.ContactNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        @(patient.RegisteredAt?.ToString("MMM dd, yyyy") ?? "—")
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/Patient/Details/@patient.PatientID"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fa-solid fa-eye me-1"></i>History
                                        </a>
                                        <button class="btn btn-sm btn-primary open-modal-btn"
                                                data-url="/Patient/Edit/@patient.PatientID"
                                                data-title="Edit Patient Details">
                                            <i class="fa-solid fa-pen me-1"></i>Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- No results row (shown by JS) -->
            <div id="noPatientResults" class="empty-state" style="display:none;">
                <div class="empty-state-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <p class="fw-semibold">No patients match your search.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('patientSearch');
    const clearBtn = document.getElementById('clearSearch');
    const countBadge = document.getElementById('patientCount');
    const noResults = document.getElementById('noPatientResults');
    const rows = document.querySelectorAll('.patient-row');

    function filterPatients() {
        const q = searchInput ? searchInput.value.toLowerCase() : '';
        let visible = 0;
        rows.forEach(row => {
            const name = (row.dataset.name || '').toLowerCase();
            const contact = (row.dataset.contact || '').toLowerCase();
            if (!q || name.includes(q) || contact.includes(q)) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });
        if (countBadge) countBadge.textContent = visible + ' patient' + (visible !== 1 ? 's' : '');
        if (noResults) noResults.style.display = visible === 0 && rows.length > 0 ? 'block' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', filterPatients);
    if (clearBtn) clearBtn.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        filterPatients();
    });
});
</script>
}