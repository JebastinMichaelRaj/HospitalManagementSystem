@model IEnumerable<HospitalManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctor Directory";
    var modelList = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-user-doctor text-primary me-2"></i>Doctor Directory
        </h2>
        <p class="text-muted mb-0">@modelList.Count specialist(s) available</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-success open-modal-btn"
                data-url="/Doctor/Create"
                data-title="Add New Doctor">
            <i class="fa-solid fa-user-plus me-2"></i>Add New Doctor
        </button>
    }
</div>

<!-- Search Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa-solid fa-search text-muted"></i>
                    </span>
                    <input type="text" id="doctorSearch" class="form-control border-start-0"
                           placeholder="Search by name, specialty or department..." />
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary" id="clearSearch">
                    <i class="fa-solid fa-rotate-left me-1"></i>Clear
                </button>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-primary px-3 py-2" id="doctorCount">@modelList.Count doctors</span>
            </div>
        </div>
    </div>
</div>

@if (!modelList.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fa-solid fa-user-doctor"></i>
        </div>
        <h5 class="fw-semibold">No Doctors Found</h5>
        <p class="text-muted">No doctors have been added to the system yet.</p>
        @if (User.IsInRole("Admin"))
        {
            <button class="btn btn-success open-modal-btn"
                    data-url="/Doctor/Create"
                    data-title="Add New Doctor">
                <i class="fa-solid fa-user-plus me-2"></i>Add First Doctor
            </button>
        }
    </div>
}
else
{
    <div class="row g-4" id="doctorGrid">
        @foreach (var doctor in modelList)
        {
            // Compute initials for avatar
            var initials = "";
            if (!string.IsNullOrEmpty(doctor.FirstName)) initials += doctor.FirstName[0].ToString().ToUpper();
            if (!string.IsNullOrEmpty(doctor.LastName)) initials += doctor.LastName[0].ToString().ToUpper();
            if (string.IsNullOrEmpty(initials)) initials = "Dr";

            // Pick a color per specialty for visual variety
            var colors = new[] { "#0d6efd", "#198754", "#0dcaf0", "#fd7e14", "#6f42c1", "#d63384" };
            int colorIdx = Math.Abs((doctor.Specialty ?? "").GetHashCode()) % colors.Length;
            var avatarColor = colors[colorIdx];

            <div class="col-md-4 col-lg-3 doctor-card-wrapper"
                 data-name="@doctor.FirstName @doctor.LastName"
                 data-specialty="@doctor.Specialty"
                 data-dept="@doctor.Department">
                <div class="card shadow-sm border-0 h-100 text-center p-3">
                    <!-- Avatar -->
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="doctor-avatar" style="background: @avatarColor;">
                            @initials
                        </div>
                    </div>

                    <h5 class="fw-bold mb-1">Dr. @doctor.FirstName @doctor.LastName</h5>

                    @if (!string.IsNullOrEmpty(doctor.Specialty))
                    {
                        <span class="badge mb-2" style="background-color: @avatarColor;">
                            <i class="fa-solid fa-stethoscope me-1"></i>@doctor.Specialty
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(doctor.Department))
                    {
                        <p class="text-muted mb-3" style="font-size:0.875rem;">
                            <i class="fa-solid fa-building me-1"></i>@doctor.Department
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-3" style="font-size:0.875rem;">
                            <i class="fa-solid fa-building me-1"></i>General
                        </p>
                    }

                    <!-- Actions -->
                    <div class="d-flex gap-2 justify-content-center mt-auto">
                       @*  <a href="/Doctor/Details/@doctor.DoctorID"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-eye me-1"></i>Profile
                        </a> *@

                        @if (User.IsInRole("Admin"))
                        {
                            <button class="btn btn-primary btn-sm open-modal-btn"
                                    data-url="/Doctor/Edit/@doctor.DoctorID"
                                    data-title="Edit Doctor Profile">
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- No results message (hidden by default) -->
    <div id="noResults" class="empty-state" style="display:none;">
        <div class="empty-state-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h5 class="fw-semibold">No doctors match your search</h5>
        <p class="text-muted">Try a different keyword or clear the filter.</p>
    </div>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('doctorSearch');
    const clearBtn = document.getElementById('clearSearch');
    const countBadge = document.getElementById('doctorCount');
    const noResults = document.getElementById('noResults');
    const cards = document.querySelectorAll('.doctor-card-wrapper');

    function filterDoctors() {
        const q = searchInput ? searchInput.value.toLowerCase() : '';
        let visible = 0;
        cards.forEach(card => {
            const name = (card.dataset.name || '').toLowerCase();
            const spec = (card.dataset.specialty || '').toLowerCase();
            const dept = (card.dataset.dept || '').toLowerCase();
            if (!q || name.includes(q) || spec.includes(q) || dept.includes(q)) {
                card.style.display = '';
                visible++;
            } else {
                card.style.display = 'none';
            }
        });
        if (countBadge) countBadge.textContent = visible + ' doctor' + (visible !== 1 ? 's' : '');
        if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', filterDoctors);
    if (clearBtn) clearBtn.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        filterDoctors();
    });
});
</script>
}