@model IEnumerable<HospitalManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
    var modelList = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-calendar-check text-primary me-2"></i>
            @(User.IsInRole("Admin") ? "All Appointments" : User.IsInRole("Doctor") ? "My Schedule" : "My Appointments")
        </h2>
        <p class="text-muted mb-0">@modelList.Count appointment(s) found</p>
    </div>

    @if (User.IsInRole("Patient") || User.IsInRole("Admin"))
    {
        <button class="btn btn-success open-modal-btn"
                data-url="/Appointment/Create"
                data-title="Book New Appointment">
            <i class="fa-solid fa-calendar-plus me-2"></i>Book Appointment
        </button>
    }
</div>

<!-- Search & Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa-solid fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Search by patient, doctor, or notes..." />
                </div>
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Scheduled">Scheduled</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" id="clearFilters">
                    <i class="fa-solid fa-rotate-left me-1"></i>Clear
                </button>
            </div>
            <div class="col-md-2 text-end">
                <span class="badge bg-primary px-3 py-2" id="resultCount">@modelList.Count results</span>
            </div>
        </div>
    </div>
</div>

<!-- Appointments Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!modelList.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <h5 class="fw-semibold">No Appointments Found</h5>
                <p class="text-muted">
                    @if (User.IsInRole("Patient"))
                    {
                        <span>You haven't booked any appointments yet.</span>
                    }
                    else
                    {
                        <span>There are no appointments to display.</span>
                    }
                </p>
                @if (User.IsInRole("Patient"))
                {
                    <button class="btn btn-success open-modal-btn"
                            data-url="/Appointment/Create"
                            data-title="Book New Appointment">
                        <i class="fa-solid fa-calendar-plus me-2"></i>Book Your First Appointment
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="appointmentsTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4"><i class="fa-regular fa-calendar me-2"></i>Date & Time</th>
                            @if (!User.IsInRole("Patient"))
                            {
                                <th><i class="fa-solid fa-user me-2"></i>Patient</th>
                            }
                            @if (!User.IsInRole("Doctor"))
                            {
                                <th><i class="fa-solid fa-user-doctor me-2"></i>Doctor</th>
                            }
                            <th><i class="fa-solid fa-tag me-2"></i>Status</th>
                            <th><i class="fa-solid fa-note-sticky me-2"></i>Notes</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="appointmentsBody">
                        @foreach (var appointment in modelList)
                        {
                            <tr class="appointment-row"
                                data-patient="@(appointment.Patient?.FirstName + " " + appointment.Patient?.LastName)"
                                data-doctor="@(appointment.Doctor?.FirstName + " " + appointment.Doctor?.LastName)"
                                data-notes="@appointment.Notes"
                                data-status="@appointment.Status">
                                <td class="ps-4">
                                    <strong>@(appointment.AppointmentDate?.ToString("MMM dd, yyyy"))</strong><br />
                                    <small class="text-muted">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @(appointment.AppointmentDate?.ToString("hh:mm tt"))
                                    </small>
                                </td>

                                @if (!User.IsInRole("Patient"))
                                {
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width:32px;height:32px;font-size:0.75rem;font-weight:700;">
                                                @(appointment.Patient?.FirstName?.Substring(0, 1).ToUpper())
                                            </div>
                                            <span>@(appointment.Patient?.FirstName) @(appointment.Patient?.LastName)</span>
                                        </div>
                                    </td>
                                }

                                @if (!User.IsInRole("Doctor"))
                                {
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="doctor-avatar" style="width:32px;height:32px;font-size:0.7rem;">
                                                Dr
                                            </div>
                                            <span>Dr. @(appointment.Doctor?.FirstName) @(appointment.Doctor?.LastName)</span>
                                        </div>
                                    </td>
                                }

                                <td>
                                    @if (appointment.Status == "Scheduled")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fa-solid fa-clock me-1"></i>Scheduled
                                        </span>
                                    }
                                    else if (appointment.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-check me-1"></i>Completed
                                        </span>
                                    }
                                    else if (appointment.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fa-solid fa-ban me-1"></i>Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@appointment.Status</span>
                                    }
                                </td>

                                <td>
                                    <small class="text-muted">
                                        @(string.IsNullOrEmpty(appointment.Notes) ? "—" : appointment.Notes)
                                    </small>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        @* Only Admins and Doctors can edit appointment status *@
                                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                                        {
                                            if (appointment.Status != "Cancelled" && appointment.Status != "Completed")
                                            {
                                                <button class="btn btn-sm btn-primary open-modal-btn"
                                                        data-url="/Appointment/Edit/@appointment.AppointmentID"
                                                        data-title="Update Appointment Status">
                                                    <i class="fa-solid fa-pen me-1"></i>Update
                                                </button>
                                            }
                                        }

                                        @* Patients can cancel their own scheduled appointments *@
                                        @if (User.IsInRole("Patient") && appointment.Status == "Scheduled")
                                        {
                                            <form asp-action="Cancel" asp-controller="Appointment"
                                                  method="post" class="confirm-action-form d-inline"
                                                  data-confirm-title="Cancel Appointment"
                                                  data-confirm-message="Are you sure you want to cancel this appointment? This action cannot be undone.">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.AppointmentID" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fa-solid fa-ban me-1"></i>Cancel
                                                </button>
                                            </form>
                                        }

                                        @if (appointment.Status == "Completed" && appointment.Billing != null)
                                        {
                                            <a href="/Billing/Details/@appointment.Billing.BillingID"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-receipt me-1"></i>Invoice
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const clearBtn = document.getElementById('clearFilters');
    const resultCount = document.getElementById('resultCount');
    const rows = document.querySelectorAll('.appointment-row');

    function filterTable() {
        const search = searchInput ? searchInput.value.toLowerCase() : '';
        const status = statusFilter ? statusFilter.value : '';
        let visible = 0;

        rows.forEach(row => {
            const patient = (row.dataset.patient || '').toLowerCase();
            const doctor = (row.dataset.doctor || '').toLowerCase();
            const notes = (row.dataset.notes || '').toLowerCase();
            const rowStatus = row.dataset.status || '';

            const matchSearch = !search ||
                patient.includes(search) ||
                doctor.includes(search) ||
                notes.includes(search);
            const matchStatus = !status || rowStatus === status;

            if (matchSearch && matchStatus) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });

        if (resultCount) resultCount.textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);
    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            if (searchInput) searchInput.value = '';
            if (statusFilter) statusFilter.value = '';
            filterTable();
        });
    }
});
</script>
}